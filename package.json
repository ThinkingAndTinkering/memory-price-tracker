{
  "name": "memory-price-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "node server/index.js",
    "seed": "node server/seed/historical.js && node server/seed/events.js",
    "seed:prices": "node server/seed/historical.js",
    "seed:events": "node server/seed/events.js",
    "scrape:trendforce": "node server/scrapers/trendforce.js",
    "scrape": "node -e \"require('./server/scrapers/index.js').runAllScrapers().then(r=>console.log(JSON.stringify(r,null,2)))\""
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "cheerio": "^1.0.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "undici": "^7.0.0"
  }
}
